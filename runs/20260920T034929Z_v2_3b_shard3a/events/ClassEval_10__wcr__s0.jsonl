{"t": 1789877548.1627884, "kind": "def", "data": {"hash": "3f927ee0af631af439ec285ad966fd3095eaf67f58b61258e3cbe1c1155262a1", "kind": "fill", "slot": "clean_non_binary_chars", "name": "clean_non_binary_chars", "canonical_src": "def clean_non_binary_chars(self):\n    self.binary_string = ''.join((v0 for v0 in self.binary_string if v0 in '01'))", "raw_src": "def clean_non_binary_chars(self):\n    \"\"\"\n        Clean the binary string by removing all non 0 or 1 characters.\n        \"\"\"\n    self.binary_string = ''.join((char for char in self.binary_string if char in '01'))", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 0, "seed": 1895921189}}}
{"t": 1789877548.1749325, "kind": "def", "data": {"hash": "300ffbaba8a260724d7e1fa37d21d4b8edfbb99befd7a6f9ff7ce8b214482437", "kind": "fill", "slot": "calculate_binary_info", "name": "calculate_binary_info", "canonical_src": "def calculate_binary_info(self):\n    v0 = len(self.binary_string)\n    v1 = self.binary_string.count('0')\n    v2 = self.binary_string.count('1')\n    v3 = v1 / v0\n    v4 = v2 / v0\n    return {'Zeroes': v3, 'Ones': v4, 'Bit length': v0}", "raw_src": "def calculate_binary_info(self):\n    \"\"\"\n        Calculate the binary string information, including the percentage of 0 and 1, and the total length of the binary string.\n        \"\"\"\n    total_length = len(self.binary_string)\n    zeroes_count = self.binary_string.count('0')\n    ones_count = self.binary_string.count('1')\n    zeroes_percentage = zeroes_count / total_length\n    ones_percentage = ones_count / total_length\n    return {'Zeroes': zeroes_percentage, 'Ones': ones_percentage, 'Bit length': total_length}", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 0, "seed": 1895921189}}}
{"t": 1789877548.17574, "kind": "def", "data": {"hash": "16e31620818e7a23d5c6ed69e68746b5dee715f49c3b767aef72b1b3ab2bbd01", "kind": "fill", "slot": "convert_to_ascii", "name": "convert_to_ascii", "canonical_src": "def convert_to_ascii(self):\n    v0 = ''.join((chr(int(self.binary_string[v1:v1 + 8], 2)) for v1 in range(0, len(self.binary_string), 8)))\n    return v0", "raw_src": "def convert_to_ascii(self):\n    \"\"\"\n        Convert the binary string to ascii string.\n        \"\"\"\n    ascii_string = ''.join((chr(int(self.binary_string[i:i + 8], 2)) for i in range(0, len(self.binary_string), 8)))\n    return ascii_string", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 0, "seed": 1895921189}}}
{"t": 1789877548.1764817, "kind": "def", "data": {"hash": "4dc36eae192751bc6c5246a1bf724732d9532e5d33d1f7f2f131b10f3fab40bb", "kind": "fill", "slot": "convert_to_utf8", "name": "convert_to_utf8", "canonical_src": "def convert_to_utf8(self):\n    v0 = ''.join((chr(int(self.binary_string[v1:v1 + 8], 2)) for v1 in range(0, len(self.binary_string), 8)))\n    return v0", "raw_src": "def convert_to_utf8(self):\n    \"\"\"\n        Convert the binary string to utf-8 string.\n        \"\"\"\n    utf8_string = ''.join((chr(int(self.binary_string[i:i + 8], 2)) for i in range(0, len(self.binary_string), 8)))\n    return utf8_string", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 0, "seed": 1895921189}}}
{"t": 1789877548.1814222, "kind": "def", "data": {"hash": "1e24e36927e3ed8eb46c88020e29e483ac08083c191f74eac4c8b5a3071a8a91", "kind": "fill", "slot": "calculate_binary_info", "name": "calculate_binary_info", "canonical_src": "def calculate_binary_info(self):\n    v0 = len(self.binary_string)\n    v1 = self.binary_string.count('0')\n    v2 = self.binary_string.count('1')\n    v3 = v1 / v0 if v0 > 0 else 0\n    v4 = v2 / v0 if v0 > 0 else 0\n    return {'Zeroes': v3, 'Ones': v4, 'Bit length': v0}", "raw_src": "def calculate_binary_info(self):\n    \"\"\"\n        Calculate the binary string information, including the percentage of 0 and 1, and the total length of the binary string.\n        \"\"\"\n    total_bits = len(self.binary_string)\n    zeroes = self.binary_string.count('0')\n    ones = self.binary_string.count('1')\n    zeroes_percent = zeroes / total_bits if total_bits > 0 else 0\n    ones_percent = ones / total_bits if total_bits > 0 else 0\n    return {'Zeroes': zeroes_percent, 'Ones': ones_percent, 'Bit length': total_bits}", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 1, "seed": 1895921190}}}
