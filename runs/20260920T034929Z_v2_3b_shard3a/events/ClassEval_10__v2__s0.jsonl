{"t": 1789876667.5766668, "kind": "def", "data": {"hash": "b0dd4c8b0286c19964b7feecbf92edf4be6df0401189deb74b1d5e669a7d8fbb", "kind": "fill", "slot": "calculate_binary_info", "name": "calculate_binary_info", "canonical_src": "def calculate_binary_info(self):\n    v0 = len(self.binary_string)\n    v1 = self.binary_string.count('0')\n    v2 = self.binary_string.count('1')\n    return {'Zeroes': v1 / v0, 'Ones': v2 / v0, 'Bit length': v0}", "raw_src": "def calculate_binary_info(self):\n    \"\"\"\n        Calculate the binary string information, including the percentage of 0 and 1, and the total length of the binary string.\n        \"\"\"\n    total_length = len(self.binary_string)\n    zeroes = self.binary_string.count('0')\n    ones = self.binary_string.count('1')\n    return {'Zeroes': zeroes / total_length, 'Ones': ones / total_length, 'Bit length': total_length}", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 0, "seed": 4135500593}}}
