{"t": 1789861408.8499923, "kind": "def", "data": {"hash": "38390296a29b57c934a187aa2cff128ef1200b76ee28531dab4223ea20f4c336", "kind": "fill", "slot": "divide", "name": "divide", "canonical_src": "def divide(c1, c2):\n    if c2.imag == 0:\n        raise ValueError('Divide by zero error')\n    return c1 / c2", "raw_src": "@staticmethod\ndef divide(c1, c2):\n    \"\"\"\n        Divides two complex numbers.\n        :param c1: The first complex number,complex.\n        :param c2: The second complex number,complex.\n        :return: The quotient of the two complex numbers,complex.\n        \"\"\"\n    if c2.imag == 0:\n        raise ValueError('Divide by zero error')\n    return c1 / c2", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 0, "seed": 2453883828}}}
