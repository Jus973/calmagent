{"t": 1789860240.2160425, "kind": "def", "data": {"hash": "e1d009aa784530f5c65085666d0f18d4d7b28a47fd4e7a5d2ca01bd0a712dd28", "kind": "fill", "slot": "clean_non_binary_chars", "name": "clean_non_binary_chars", "canonical_src": "def clean_non_binary_chars(self):\n    pass", "raw_src": "def clean_non_binary_chars(self):\n    \"\"\"\n        Clean the binary string by removing all non 0 or 1 characters.\n        >>> bdp = BinaryDataProcessor(\"01101000daf3e4r01100101011011000110110001101111\")\n        >>> bdp.clean_non_binary_chars()\n        >>> bdp.binary_string\n        '0110100001100101011011000110110001101111'\n\n        \"\"\"", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 0, "seed": 1895921189}}}
