{"t": 1789860240.2182817, "kind": "def", "data": {"hash": "4dc36eae192751bc6c5246a1bf724732d9532e5d33d1f7f2f131b10f3fab40bb", "kind": "fill", "slot": "convert_to_utf8", "name": "convert_to_utf8", "canonical_src": "def convert_to_utf8(self):\n    v0 = ''.join((chr(int(self.binary_string[v1:v1 + 8], 2)) for v1 in range(0, len(self.binary_string), 8)))\n    return v0", "raw_src": "def convert_to_utf8(self):\n    \"\"\"\n        Convert the binary string to utf-8 string.\n        >>> bdp = BinaryDataProcessor(\"0110100001100101011011000110110001101111\")\n        >>> bdp.convert_to_utf8()\n        'hello'\n        \"\"\"\n    ascii_string = ''.join((chr(int(self.binary_string[i:i + 8], 2)) for i in range(0, len(self.binary_string), 8)))\n    return ascii_string", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 1, "seed": 1895921190}}}
{"t": 1789860240.2212167, "kind": "def", "data": {"hash": "3f927ee0af631af439ec285ad966fd3095eaf67f58b61258e3cbe1c1155262a1", "kind": "fill", "slot": "clean_non_binary_chars", "name": "clean_non_binary_chars", "canonical_src": "def clean_non_binary_chars(self):\n    self.binary_string = ''.join((v0 for v0 in self.binary_string if v0 in '01'))", "raw_src": "def clean_non_binary_chars(self):\n    \"\"\"\n        Clean the binary string by removing all non 0 or 1 characters.\n        \"\"\"\n    self.binary_string = ''.join((c for c in self.binary_string if c in '01'))", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 3, "seed": 1895921192}}}
{"t": 1789860240.222156, "kind": "def", "data": {"hash": "150d1835925ea7f29410576b930e22c363f347bad26465df25a27ea5f009e1bb", "kind": "fill", "slot": "calculate_binary_info", "name": "calculate_binary_info", "canonical_src": "def calculate_binary_info(self):\n    v0 = self.binary_string.count('0')\n    v1 = self.binary_string.count('1')\n    v2 = len(self.binary_string)\n    v3 = v0 / v2 * 100\n    v4 = v1 / v2 * 100\n    return {'Zeroes': v3, 'Ones': v4, 'Bit length': v2}", "raw_src": "def calculate_binary_info(self):\n    \"\"\"\n        Calculate the binary string information, including the percentage of 0 and 1, and the total length of the binary string.\n        \"\"\"\n    zero_count = self.binary_string.count('0')\n    one_count = self.binary_string.count('1')\n    bit_length = len(self.binary_string)\n    percentage_zero = zero_count / bit_length * 100\n    percentage_one = one_count / bit_length * 100\n    return {'Zeroes': percentage_zero, 'Ones': percentage_one, 'Bit length': bit_length}", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 3, "seed": 1895921192}}}
