{"t": 1789861408.85675, "kind": "def", "data": {"hash": "88d926bf654a86c8ed0f8f7245ee48874b67567e1e47b74fbc10b25052f37c24", "kind": "fill", "slot": "multiply", "name": "multiply", "canonical_src": "def multiply(c1, c2):\n    return complex(c1.real * c2.real - c1.imag * c2.imag, c1.real * c2.imag + c1.imag * c2.real)", "raw_src": "@staticmethod\ndef multiply(c1, c2):\n    \"\"\"\n        Multiplies two complex numbers.\n        :param c1: The first complex number,complex.\n        :param c2: The second complex number,complex.\n        :return: The product of the two complex numbers,complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.multiply(1+2j, 3+4j)\n        (-5+10j)\n        \"\"\"\n    return complex(c1.real * c2.real - c1.imag * c2.imag, c1.real * c2.imag + c1.imag * c2.real)", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 2, "seed": 2453883830}}}
{"t": 1789861408.857619, "kind": "def", "data": {"hash": "e89baa1d9cda083a952ac7c19965672bdb14f201818051469e36add4d4407f53", "kind": "fill", "slot": "divide", "name": "divide", "canonical_src": "def divide(c1, c2):\n    v0 = c2.real ** 2 + c2.imag ** 2\n    return complex((c1.real * c2.real + c1.imag * c2.imag) / v0, (c1.real * c2.imag - c1.imag * c2.real) / v0)", "raw_src": "@staticmethod\ndef divide(c1, c2):\n    \"\"\"\n        Divides two complex numbers.\n        :param c1: The first complex number,complex.\n        :param c2: The second complex number,complex.\n        :return: The quotient of the two complex numbers,complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.divide(1+2j, 3+4j)\n        (0.44+0.08j)\n        \"\"\"\n    denominator = c2.real ** 2 + c2.imag ** 2\n    return complex((c1.real * c2.real + c1.imag * c2.imag) / denominator, (c1.real * c2.imag - c1.imag * c2.real) / denominator)", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "wcr", "round": 0, "sample_idx": 2, "seed": 2453883830}}}
