{"t": 1789861269.2673209, "kind": "def", "data": {"hash": "884ed26df5683e8e0b9d74051383a8abac0c473c34d555470e597a0d2976f456", "kind": "fill", "slot": "divide", "name": "divide", "canonical_src": "def divide(c1, c2):\n    if c2 == 0 + 0j:\n        return None\n    return ((c1.real * c2.real - c1.imag * c2.imag) / (c2.real ** 2 + c2.imag ** 2), (c1.real * c2.imag + c1.imag * c2.real) / (c2.real ** 2 + c2.imag ** 2))", "raw_src": "@staticmethod\ndef divide(c1, c2):\n    \"\"\"\n        Divides two complex numbers.\n        :param c1: The first complex number,complex.\n        :param c2: The second complex number,complex.\n        :return: The quotient of the two complex numbers,complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.divide(1+2j, 3+4j)\n        (0.44+0.08j)\n        \"\"\"\n    if c2 == 0 + 0j:\n        return None\n    return ((c1.real * c2.real - c1.imag * c2.imag) / (c2.real ** 2 + c2.imag ** 2), (c1.real * c2.imag + c1.imag * c2.real) / (c2.real ** 2 + c2.imag ** 2))", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 3, "seed": 4069063867}}}
