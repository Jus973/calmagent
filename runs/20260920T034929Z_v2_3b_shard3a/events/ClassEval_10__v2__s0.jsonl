{"t": 1789876667.5845063, "kind": "def", "data": {"hash": "b2c59784bcbac2320156e46c26e2245686e65bed6983a981f84afa0f180a2d29", "kind": "fill", "slot": "calculate_binary_info", "name": "calculate_binary_info", "canonical_src": "def calculate_binary_info(self):\n    v0 = len(self.binary_string)\n    v1 = self.binary_string.count('1')\n    v2 = self.binary_string.count('0')\n    v3 = v1 / v0 if v0 > 0 else 0\n    v4 = v2 / v0 if v0 > 0 else 0\n    return {'Zeroes': v4, 'Ones': v3, 'Bit length': v0}", "raw_src": "def calculate_binary_info(self):\n    \"\"\"\n        Calculate the binary string information, including the percentage of 0 and 1, and the total length of the binary string.\n        \"\"\"\n    total_length = len(self.binary_string)\n    ones_count = self.binary_string.count('1')\n    zeroes_count = self.binary_string.count('0')\n    ones_percentage = ones_count / total_length if total_length > 0 else 0\n    zeroes_percentage = zeroes_count / total_length if total_length > 0 else 0\n    return {'Zeroes': zeroes_percentage, 'Ones': ones_percentage, 'Bit length': total_length}", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": false, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 1, "seed": 4135500594}}}
