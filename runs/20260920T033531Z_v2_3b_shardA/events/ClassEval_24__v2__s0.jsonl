{"t": 1789878222.235938, "kind": "def", "data": {"hash": "e400af37ab51639f512ae75a884b1b00f5bcca97d1affc8dd223a24019e4706f", "kind": "fill", "slot": "add", "name": "add", "canonical_src": "def add(c1, c2):\n    return c1.real + c2.real + (c1.imag + c2.imag) * 1j", "raw_src": "@staticmethod\ndef add(c1, c2):\n    \"\"\"\n        Adds two complex numbers.\n        :param c1: The first complex number, complex.\n        :param c2: The second complex number, complex.\n        :return: The sum of the two complex numbers, complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.add(1+2j, 3+4j)\n        (4+6j)\n\n        \"\"\"\n    return c1.real + c2.real + (c1.imag + c2.imag) * 1j", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 0, "seed": 4069063864}}}
{"t": 1789878222.2365446, "kind": "def", "data": {"hash": "a54c9ac47cfad3e1876273709d6c415262d2516abbababc25cd6badf18154102", "kind": "fill", "slot": "subtract", "name": "subtract", "canonical_src": "def subtract(c1, c2):\n    return c1.real - c2.real + (c1.imag - c2.imag) * 1j", "raw_src": "@staticmethod\ndef subtract(c1, c2):\n    \"\"\"\n        Subtracts two complex numbers.\n        :param c1: The first complex number, complex.\n        :param c2: The second complex number, complex.\n        :return: The difference of the two complex numbers, complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.subtract(1+2j, 3+4j)\n        (-2-2j)\n\n        \"\"\"\n    return c1.real - c2.real + (c1.imag - c2.imag) * 1j", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 0, "seed": 4069063864}}}
{"t": 1789878222.2372026, "kind": "def", "data": {"hash": "745de6570ea9ee41675403ba02512cdb088d8ec14100b957097c125fd79a4807", "kind": "fill", "slot": "multiply", "name": "multiply", "canonical_src": "def multiply(c1, c2):\n    return c1.real * c2.real - c1.imag * c2.imag + (c1.real * c2.imag + c1.imag * c2.real) * 1j", "raw_src": "@staticmethod\ndef multiply(c1, c2):\n    \"\"\"\n        Multiplies two complex numbers.\n        :param c1: The first complex number, complex.\n        :param c2: The second complex number, complex.\n        :return: The product of the two complex numbers, complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.multiply(1+2j, 3+4j)\n        (-5+10j)\n\n        \"\"\"\n    return c1.real * c2.real - c1.imag * c2.imag + (c1.real * c2.imag + c1.imag * c2.real) * 1j", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 0, "seed": 4069063864}}}
{"t": 1789878222.238658, "kind": "def", "data": {"hash": "f3bcf55d010e2016a040c27b2c7047202ad23841117b968135ff60a32ea40a3c", "kind": "fill", "slot": "divide", "name": "divide", "canonical_src": "def divide(c1, c2):\n    v0 = (c1.real * c2.real + c1.imag * c2.imag) / (c2.real ** 2 + c2.imag ** 2)\n    v1 = (c1.imag * c2.real - c1.real * c2.imag) / (c2.real ** 2 + c2.imag ** 2)\n    return complex(v0, v1)", "raw_src": "@staticmethod\ndef divide(c1, c2):\n    \"\"\"\n        Divides two complex numbers.\n        :param c1: The first complex number, complex.\n        :param c2: The second complex number, complex.\n        :return: The quotient of the two complex numbers, complex.\n        >>> complexCalculator = ComplexCalculator()\n        >>> complexCalculator.divide(1+2j, 3+4j)\n        (0.44+0.08j)\n\n        \"\"\"\n    real_part = (c1.real * c2.real + c1.imag * c2.imag) / (c2.real ** 2 + c2.imag ** 2)\n    imag_part = (c1.imag * c2.real - c1.real * c2.imag) / (c2.real ** 2 + c2.imag ** 2)\n    return complex(real_part, imag_part)", "slot_refs": [], "helper_refs": [], "unresolved_refs": [], "is_static": true, "meta": {"producer": "whole_class", "arm": "v2", "round": 0, "sample_idx": 0, "seed": 4069063864}}}
